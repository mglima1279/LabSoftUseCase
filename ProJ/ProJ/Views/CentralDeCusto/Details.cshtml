@model ProJ.Models.CentralDeCusto
@{
    ViewData["Title"] = "Detalhes da central de custo";
}
<div class="page-head">
    <h1>Detalhes da central de custo</h1>
</div>

<div class="panel-quiet" style="max-width:560px;">
    <div class="person-cell mb-4">
        <span class="id-tag" style="width:44px;height:44px;font-size:1.1rem;">#@Model.Codigo</span>
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;">@Model.NomeCentral</div>
        </div>
    </div>

    <dl class="record row">
        <dt class="col-sm-4">Meta Anual</dt>
        <dd class="col-sm-8">
            @if (Model.ValorMetaAnual.HasValue)
            {
                @Model.ValorMetaAnual.Value.ToString("C")
            }
            else
            {
                <span style="color:var(--steel-light)">Sem meta cadastrada</span>
            }
        </dd>
    </dl>
</div>
<div class="mt-3">
    <a class="btn-ops-outline" asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a>
    <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
</div>