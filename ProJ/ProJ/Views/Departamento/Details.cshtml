@model ProJ.Models.Departamento
@{
    ViewData["Title"] = "Detalhes do departamento";
}
<div class="page-head">
    <h1>Detalhes do departamento</h1>
</div>

<div class="panel-quiet" style="max-width:560px;">
    <div class="person-cell mb-4">
        <span class="id-tag" style="width:44px;height:44px;font-size:1.1rem;">@(Model.Sigla?.Substring(0, Math.Min(2, Model.Sigla.Length)).ToUpper())</span>
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;">@Model.Nome</div>
            <div style="color:var(--steel);font-size:0.9rem;">Sigla: @Model.Sigla</div>
        </div>
    </div>

    <dl class="record row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Sigla)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Sigla)</dd>
    </dl>
</div>
<div class="mt-3">
    <a class="btn-ops-outline" asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a>
    <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
</div>