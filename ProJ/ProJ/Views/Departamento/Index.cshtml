@model IEnumerable<ProJ.Models.Departamento>
@{
    ViewData["Title"] = "Departamentos";
}
<div class="page-head">
    <div class="page-head-row">
        <div>
            <h1>Departamentos</h1>
            <p>Gerenciamento dos setores e departamentos da empresa.</p>
        </div>
        <a class="btn-ops-primary" asp-action="Create">Novo departamento</a>
    </div>
</div>

<table class="table-ledger">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Sigla)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="person-cell">
                        <span class="id-tag">@(item.Sigla?.Substring(0, Math.Min(2, item.Sigla.Length)).ToUpper())</span>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </div>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Sigla)</td>
                <td class="row-actions text-end">
                    <a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a>
                    <span class="sep">|</span>
                    <a asp-action="Details" asp-route-id="@item.Codigo">Detalhes</a>
                    <span class="sep">|</span>
                    <a asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>