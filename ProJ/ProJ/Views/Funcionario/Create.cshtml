@model ProJ.Models.Funcionario
@{
    ViewData["Title"] = "Novo funcionário";
}
<div class="page-head">
    <h1>Novo funcionário</h1>
    <p>Cadastre um colaborador e, se houver, o gerente responsável por ele.</p>
</div>

<div class="panel" style="max-width:520px;">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="field">
            <label asp-for="Nome">Nome completo</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Cargo">Cargo</label>
            <input asp-for="Cargo" class="form-control" />
            <span asp-validation-for="Cargo" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="IdGerente">Gerente responsável</label>
            <select asp-for="IdGerente" class="form-control" asp-items="ViewBag.IdGerente"></select>
        </div>
        <div class="mt-3">
            <input type="submit" value="Criar funcionário" class="btn-ops-primary" style="border:none;cursor:pointer;" />
        </div>
    </form>
</div>
<div class="mt-3">
    <a class="btn-ops-link" asp-action="Index">Voltar à lista</a>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
