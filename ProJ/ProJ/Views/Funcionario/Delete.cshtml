@model ProJ.Models.Funcionario
@{
    ViewData["Title"] = "Excluir funcionário";
}
<div class="page-head">
    <h1>Excluir funcionário</h1>
</div>

<div class="confirm-banner">
    Confirme abaixo a exclusão deste registro. Essa ação não pode ser desfeita.
</div>

<div class="panel-quiet" style="max-width:560px;">
    <dl class="record row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cargo)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Cargo)</dd>

        <dt class="col-sm-4">Departamento</dt>
        <dd class="col-sm-8">
            @if (Model.Departamento != null)
            {
                @Html.DisplayFor(model => model.Departamento.Nome)
            }
            else
            {
                <span style="color:var(--steel-light)">—</span>
            }
        </dd>

        <dt class="col-sm-4">Gerente</dt>
        <dd class="col-sm-8">
            @if (Model.IdGerenteNavigation != null)
            {
                @Html.DisplayFor(model => model.IdGerenteNavigation.Nome)
            }
            else
            {
                <span style="color:var(--steel-light)">Sem gerente cadastrado</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-2">
        <input type="hidden" asp-for="Codigo" />
        <input type="submit" value="Excluir" class="btn-ops-danger" style="border:none;cursor:pointer;" />
        <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
    </form>
</div>