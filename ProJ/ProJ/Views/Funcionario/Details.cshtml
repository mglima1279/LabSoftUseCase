@model ProJ.Models.Funcionario
@{
    ViewData["Title"] = "Detalhes do funcionário";
}
<div class="page-head">
    <h1>Detalhes do funcionário</h1>
</div>

<div class="panel-quiet" style="max-width:560px;">
    <div class="person-cell mb-4">
        <span class="id-tag" style="width:44px;height:44px;font-size:1.1rem;">@(Model.Nome?.Substring(0, 1).ToUpper())</span>
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;">@Model.Nome</div>
            <div style="color:var(--steel);font-size:0.9rem;">@Model.Cargo</div>
        </div>
    </div>

    <dl class="record row">
        <dt class="col-sm-3">Gerente</dt>
        <dd class="col-sm-9">
            @if (Model.IdGerenteNavigation != null)
            {
                @Html.DisplayFor(model => model.IdGerenteNavigation.Nome)
            }
            else
            {
                <span style="color:var(--steel-light)">Sem gerente cadastrado</span>
            }
        </dd>
    </dl>
</div>
<div class="mt-3">
    <a class="btn-ops-outline" asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a>
    <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
</div>
