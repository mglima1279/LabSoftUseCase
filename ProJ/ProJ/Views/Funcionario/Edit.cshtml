@model ProJ.Models.Funcionario
@{
    ViewData["Title"] = "Editar funcionário";
}
<div class="page-head">
    <h1>Editar funcionário</h1>
    <p>Atualize os dados de @Model.Nome.</p>
</div>

<div class="panel" style="max-width:520px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="Codigo" />
        <div class="field">
            <label asp-for="Nome">Nome completo</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="Cargo">Cargo</label>
            <input asp-for="Cargo" class="form-control" />
            <span asp-validation-for="Cargo" class="text-danger"></span>
        </div>
        <div class="field">
            <label asp-for="IdGerente">Gerente responsável</label>
            <select asp-for="IdGerente" class="form-control" asp-items="ViewBag.IdGerente">
                <option value="">
                    -
                </option>
            </select>
            <span asp-validation-for="IdGerente" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <input type="submit" value="Salvar alterações" class="btn-ops-primary" style="border:none;cursor:pointer;" />
        </div>
    </form>
</div>
<div class="mt-3">
    <a class="btn-ops-link" asp-action="Index">Voltar à lista</a>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
