@model ProJ.Models.Incidente
@{
    ViewData["Title"] = "Detalhes do incidente";
}
<div class="page-head">
    <h1>Detalhes do incidente</h1>
</div>

<div class="panel-quiet" style="max-width:560px;">
    <div class="person-cell mb-4">
        <span class="id-tag" style="width:44px;height:44px;font-size:1.1rem;">#@Model.Codigo</span>
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;">@Model.DescricaoProblema</div>
            <div style="color:var(--steel);font-size:0.9rem;">
                Status: @(Model.Resolvido == "S" || Model.Resolvido == "Sim" || Model.Resolvido == "1" ? "Resolvido" : "Pendente")
            </div>
        </div>
    </div>

    <dl class="record row">
        <dt class="col-sm-4">Data Ocorrência</dt>
        <dd class="col-sm-8">@Model.DataIncidente.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-4">Solução</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Solucao))
            {
                @Html.DisplayFor(model => model.Solucao)
            }
            else
            {
                <span style="color:var(--steel-light)">Sem solução cadastrada até o momento</span>
            }
        </dd>
    </dl>
</div>
<div class="mt-3">
    <a class="btn-ops-outline" asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a>
    <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
</div>