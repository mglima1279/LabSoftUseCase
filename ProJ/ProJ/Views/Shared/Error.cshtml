@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}
<div class="page-head">
    <h1>Ocorreu um erro ao processar a solicitação.</h1>
</div>

<div class="confirm-banner">
    @if (Model.ShowRequestId)
    {
        <span>ID da requisição: <code>@Model.RequestId</code></span>
    }
    else
    {
        <span>Nenhum identificador de requisição foi capturado para este erro.</span>
    }
</div>

<div class="panel-quiet">
    <h4>Ambiente de desenvolvimento</h4>
    <p class="mb-2" style="color:var(--steel)">
        Alternar para o ambiente <strong>Development</strong> exibe informações mais detalhadas sobre o erro ocorrido.
    </p>
    <p class="mb-0" style="color:var(--steel)">
        <strong>O ambiente Development não deve ficar habilitado em aplicações publicadas</strong>,
        pois pode expor informações sensíveis de exceções aos usuários finais.
        Para depuração local, defina a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como
        <strong>Development</strong> e reinicie a aplicação.
    </p>
</div>
