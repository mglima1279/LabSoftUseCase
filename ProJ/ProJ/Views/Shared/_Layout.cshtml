<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Vida & Saúde</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                Vida & Saúde
            </a>

            <ul class="navbar-nav">

                <li>
                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Início
                    </a>
                </li>

                <li>
                    <a class="nav-link"
                       asp-controller="Paciente"
                       asp-action="Index">
                        Pacientes
                    </a>
                </li>

                <li>
                    <a class="nav-link"
                       asp-controller="Medico"
                       asp-action="Index">
                        Médicos
                    </a>
                </li>

                <li>
                    <a class="nav-link"
                       asp-controller="Consulta"
                       asp-action="Index">
                        Consultas
                    </a>
                </li>

            </ul>

        </nav>
    </header>


    <main class="container">

        @RenderBody()

    </main>


    <footer>
        <span>
            &copy; @DateTime.Now.Year Vida & Saúde
            · Sistema de Gestão de Clínica
        </span>
    </footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>