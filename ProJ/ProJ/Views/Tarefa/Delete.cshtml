@model ProJ.Models.Tarefa
@{
    ViewData["Title"] = "Excluir tarefa";
}
<div class="page-head">
    <h1>Excluir tarefa</h1>
</div>

<div class="confirm-banner">
    Confirme abaixo a exclusão deste registro. Essa ação não pode ser desfeita.
</div>

<div class="panel-quiet" style="max-width:560px;">
    <dl class="record row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descricao)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Descricao)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StatusTarefa)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.StatusTarefa)</dd>

        <dt class="col-sm-4">Responsável</dt>
        <dd class="col-sm-8">
            @if (Model.Funcionario != null)
            {
                @Html.DisplayFor(model => model.Funcionario.Nome)
            }
            else
            {
                <span style="color:var(--steel-light)">Sem responsável cadastrado</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-2">
        <input type="hidden" asp-for="Codigo" />
        <input type="submit" value="Excluir" class="btn-ops-danger" style="border:none;cursor:pointer;" />
        <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
    </form>
</div>