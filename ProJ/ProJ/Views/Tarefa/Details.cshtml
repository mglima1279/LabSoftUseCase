@model ProJ.Models.Tarefa
@{
    ViewData["Title"] = "Detalhes da tarefa";
}
<div class="page-head">
    <h1>Detalhes da tarefa</h1>
</div>

<div class="panel-quiet" style="max-width:560px;">
    <div class="person-cell mb-4">
        <span class="id-tag" style="width:44px;height:44px;font-size:1.1rem;">#@Model.Codigo</span>
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;">@Model.Descricao</div>
            <div style="color:var(--steel);font-size:0.9rem;">Status: @Model.StatusTarefa</div>
        </div>
    </div>

    <dl class="record row">
        <dt class="col-sm-4">Responsável</dt>
        <dd class="col-sm-8">
            @if (Model.Funcionario != null)
            {
                @Html.DisplayFor(model => model.Funcionario.Nome)
            }
            else
            {
                <span style="color:var(--steel-light)">Sem responsável cadastrado</span>
            }
        </dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Prazo)</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Prazo))
            {
                @Html.DisplayFor(model => model.Prazo)
            }
            else
            {
                <span style="color:var(--steel-light)">—</span>
            }
        </dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataPlanejada)</dt>
        <dd class="col-sm-8">@Model.DataPlanejada.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataIniciada)</dt>
        <dd class="col-sm-8">@(Model.DataIniciada.HasValue? Model.DataIniciada.Value.ToString("dd/MM/yyyy") : "—")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataFinalizada)</dt>
        <dd class="col-sm-8">@(Model.DataFinalizada.HasValue? Model.DataFinalizada.Value.ToString("dd/MM/yyyy") : "—")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DataCancelada)</dt>
        <dd class="col-sm-8">@(Model.DataCancelada.HasValue? Model.DataCancelada.Value.ToString("dd/MM/yyyy") : "—")</dd>
    </dl>
</div>
<div class="mt-3">
    <a class="btn-ops-outline" asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a>
    <a class="btn-ops-link ms-3" asp-action="Index">Voltar à lista</a>
</div>