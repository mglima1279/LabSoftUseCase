@model ProJ.Models.Tarefa
@{
    ViewData["Title"] = "Editar tarefa";
}
<div class="page-head">
    <h1>Editar tarefa</h1>
    <p>Atualize as informações da tarefa #@Model.Codigo.</p>
</div>

<div class="panel" style="max-width:520px;">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="Codigo" />

        <div class="field">
            <label asp-for="Descricao">Descrição</label>
            <input asp-for="Descricao" class="form-control" />
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="StatusTarefa">Status</label>
            <input asp-for="StatusTarefa" class="form-control" />
            <span asp-validation-for="StatusTarefa" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="Prazo">Prazo</label>
            <input asp-for="Prazo" type="date" class="form-control" />
            <span asp-validation-for="Prazo" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="DataPlanejada">Data Planejada</label>
            <input asp-for="DataPlanejada" type="date" class="form-control" />
            <span asp-validation-for="DataPlanejada" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="DataIniciada">Data de Início</label>
            <input asp-for="DataIniciada" type="date" class="form-control" />
            <span asp-validation-for="DataIniciada" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="DataFinalizada">Data de Finalização</label>
            <input asp-for="DataFinalizada" type="date" class="form-control" />
            <span asp-validation-for="DataFinalizada" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="DataCancelada">Data de Cancelamento</label>
            <input asp-for="DataCancelada" type="date" class="form-control" />
            <span asp-validation-for="DataCancelada" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="FuncionarioId">Responsável</label>
            <select asp-for="FuncionarioId" class="form-control" asp-items="ViewBag.FuncionarioId"></select>
            <span asp-validation-for="FuncionarioId" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <input type="submit" value="Salvar alterações" class="btn-ops-primary" style="border:none;cursor:pointer;" />
        </div>
    </form>
</div>
<div class="mt-3">
    <a class="btn-ops-link" asp-action="Index">Voltar à lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}