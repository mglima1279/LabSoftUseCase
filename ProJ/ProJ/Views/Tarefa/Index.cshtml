@model IEnumerable<ProJ.Models.Tarefa>
@{
    ViewData["Title"] = "Tarefas";
}
<div class="page-head">
    <div class="page-head-row">
        <div>
            <h1>Tarefas</h1>
            <p>Gerenciamento e acompanhamento das atividades da equipe.</p>
        </div>
        <a class="btn-ops-primary" asp-action="Create">Nova tarefa</a>
    </div>
</div>

<table class="table-ledger">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Descricao)</th>
            <th>@Html.DisplayNameFor(model => model.StatusTarefa)</th>
            <th>@Html.DisplayNameFor(model => model.Prazo)</th>
            <th>Responsável</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                <td>@Html.DisplayFor(modelItem => item.StatusTarefa)</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Prazo))
                    {
                        @Html.DisplayFor(modelItem => item.Prazo)
                    }
                    else
                    {
                        <span style="color:var(--steel-light)">—</span>
                    }
                </td>
                <td>
                    @if (item.Funcionario != null)
                    {
                        <div class="person-cell">
                            <span class="id-tag">@(item.Funcionario.Nome?.Substring(0, 1).ToUpper())</span>
                            @Html.DisplayFor(modelItem => item.Funcionario.Nome)
                        </div>
                    }
                    else
                    {
                        <span style="color:var(--steel-light)">— sem responsável</span>
                    }
                </td>
                <td class="row-actions text-end">
                    <a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a>
                    <span class="sep">|</span>
                    <a asp-action="Details" asp-route-id="@item.Codigo">Detalhes</a>
                    <span class="sep">|</span>
                    <a asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>